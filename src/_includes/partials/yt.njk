<div class="yt" data-yt="{{ v.id }}">
  <img src="{{ poster }}" alt="" width="1280" height="720" loading="lazy">
  <button class="yt-play" type="button" aria-label="Play {{ v.title }} (loads YouTube)"><span aria-hidden="true">▶</span></button>
  <a class="yt-link" href="https://www.youtube.com/watch?v={{ v.id }}" rel="noopener" target="_blank">Watch on YouTube</a>
</div>
