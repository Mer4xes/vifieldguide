<!doctype html>
<html lang="en" data-launch="{{ site.launch }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set isHome = page.url == "/" %}
{%- set metaTitle = seoTitle or title %}
{%- set metaDesc = description or summary or site.description %}
<title>{% if isHome %}{{ metaTitle }}{% else %}{{ metaTitle }} | {{ site.name }}{% endif %}</title>
<meta name="description" content="{{ metaDesc }}">
{%- if sample or noindex %}
<meta name="robots" content="noindex, nofollow">
{%- else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- endif %}
{%- if site.googleSiteVerification %}
<meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
{%- endif %}
{%- if site.bingSiteVerification %}
<meta name="msvalidate.01" content="{{ site.bingSiteVerification }}">
{%- endif %}
<meta property="og:site_name" content="{{ site.longName }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:type" content="{% if schema == 'article' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- if site.ogImage %}
<meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
<meta property="og:image:width" content="{{ site.ogImageW }}">
<meta property="og:image:height" content="{{ site.ogImageH }}">
<meta property="og:image:alt" content="{{ site.longName }} — GTA 6 walkthrough and guide">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}">
{%- endif %}
<meta name="theme-color" content="#0b0711">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/atom+xml" title="{{ site.longName }} — updates" href="/feed.xml">
<link rel="preload" href="/assets/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css?v={{ site.buildId }}">
<script>(function(){var r=document.documentElement;try{var p=JSON.parse(localStorage.getItem("vfg.prefs.v1")||"{}");if(p.spoilers)r.classList.add("spoilers-on");if(p.hideAhead)r.classList.add("hide-ahead")}catch(e){}if(Date.now()>=new Date(r.getAttribute("data-launch")).getTime())r.classList.add("is-live")})()</script>
{% ldjson title, metaTitle, metaDesc, crumbParent, schema, updated, published %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="nav">
  <div class="wrap nav-row">
    <a class="brand" href="/">VI&nbsp;Field&nbsp;Guide</a>
    <a class="nav-search" href="/search/" aria-label="Search the guide" title="Search (press /)"{% if page.url == "/search/" %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></a>
    {%- if site.donate and site.donate.url %}
    <a class="nav-support" href="{{ site.donate.url }}" rel="noopener" target="_blank" aria-label="Support the guide on Ko-fi" title="Support the guide on Ko-fi"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.6.8-1.4 2.3-2.6 4.4-2.6 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z"/></svg><span>Support</span></a>
    {%- endif %}
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <nav class="nav-links" id="nav-links" aria-label="Sections">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      <button type="button" class="sp-toggle" data-pref="spoilers" aria-pressed="false" data-on="Spoilers shown" data-off="Spoilers hidden"><span class="dot" aria-hidden="true"></span><span data-label>Spoilers hidden</span></button>
    </nav>
  </div>
</header>
<div id="page" data-route="{{ page.url }}"><!--page:start-->
{%- if sample %}
<div class="fiction">
  <div class="wrap">
    <span class="tag">Fictional sample</span>
    <p>{{ sampleNote or "Invented content that shows the page format. It is not real game content, and it is left out of the live site." }}</p>
  </div>
</div>
{%- endif %}
{%- if not isHome and not hideCrumbs %}
<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <a href="/">Home</a>
    {%- if crumbParent and crumbParent.url %}<span aria-hidden="true">/</span><a href="{{ crumbParent.url }}">{{ crumbParent.label }}</a>{% endif -%}
    <span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span>
  </div>
</nav>
{%- endif %}
<main id="main">
{{ content | safe }}
</main>
{%- if site.donate and site.donate.url and not hideSupport %}
<aside class="support-band" aria-label="Support the guide">
  <div class="wrap support-row">
    <div class="support-ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.6.8-1.4 2.3-2.6 4.4-2.6 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z"/></svg></div>
    <div class="support-txt">
      <p class="support-h">Found this useful?</p>
      <p>The VI Field Guide is free, with no ads and no paywall. If it saved you some time in Leonida, a small tip helps keep it updated.</p>
    </div>
    <a class="btn-support" href="{{ site.donate.url }}" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.6.8-1.4 2.3-2.6 4.4-2.6 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z"/></svg><span>{{ site.donate.label }} on Ko-fi</span></a>
  </div>
</aside>
{%- endif %}
<!--page:end--></div>
<footer class="foot">
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <p class="foot-brand">The VI Field Guide</p>
        <p class="foot-note">Checklists and progress are saved in this browser only. Nothing is sent anywhere.</p>
        {%- if site.social and site.social.length %}
        <p class="foot-social">Follow:{% for s in site.social %} <a href="{{ s.url }}" rel="me noopener" target="_blank">{{ s.label }}</a>{% if not loop.last %} ·{% endif %}{% endfor %}</p>
        {%- endif %}
        {%- if site.donate and site.donate.url and hideSupport %}
        <p class="foot-donate"><a class="btn-donate" href="{{ site.donate.url }}" rel="noopener" target="_blank">♥ {{ site.donate.label }}</a><span>Free to use. If it helped, a small tip keeps it going.</span></p>
        {%- endif %}
      </div>
      <nav class="foot-links" aria-label="More">
        <a href="/guides/launch-guide/">Launch guide</a>
        <a href="/guides/100-percent-checklist/">100% checklist</a>
        <a href="/guides/100-percent-route/">100% route</a>
        <a href="/guides/missables/">Missables</a>
        <a href="/guides/challenges/">All 80 challenges</a>
        <a href="/guides/activities-and-collectibles/">Activities and collectibles</a>
        <a href="/collectibles/#by-area">Collectibles by area</a>
        <a href="/guides/side-contacts/">Side contacts</a>
        <a href="/guides/fences/">Fences</a>
        <a href="/guides/money/">Money guide</a>
        <a href="/guides/story-choices/">Story choices</a>
        <a href="/guides/mission-rewards/">Mission rewards</a>
        <a href="/characters/">Characters</a>
        <a href="/videos/">Trailers and videos</a>
        <a href="/how-it-plays/">How it plays</a>
        <a href="/activities/">Activities</a>
        <a href="/wildlife/">Wildlife and weather</a>
        <a href="/music/">Music</a>
        <a href="/search/">Search</a>
        <a href="/about/">About and spoiler policy</a>
      </nav>
    </div>
    <p class="disc">{{ site.disclaimer }}</p>
  </div>
</footer>
<script src="/assets/site.js?v={{ site.buildId }}" defer></script>
</body>
</html>
