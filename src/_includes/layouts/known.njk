---
layout: layouts/base.njk
schema: article
---
<header class="mast{% if image %} photo{% endif %}" style="--glow:var(--{{ glow or 'pink' }})">
  {%- if image %}<img class="mast-img" src="{{ image }}" alt="" width="1600" height="900" fetchpriority="high">{% endif %}
  <div class="wrap">
    <p class="kicker">{{ kicker or "What we know" }}</p>
    <h1>{{ headline or title }}</h1>
    {%- if summary %}<p class="tagline">{{ summary }}</p>{% endif %}
    <div class="chips">
      <span class="chip ok dot">Confirmed before launch</span>
      {%- if updated %}<span class="chip plain">Updated {{ updated | niceDate }}</span>{% endif %}
    </div>
    {%- if facts %}
    <div class="facts">
      {%- for f in facts %}
      <div class="fact"><div class="k">{{ f.k }}</div><div class="v sm">{{ f.v }}</div>{% if f.status %}<span class="chip {% if f.status == 'Confirmed' %}ok{% else %}rum{% endif %} dot">{{ f.status }}</span>{% endif %}</div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
  {%- if image %}<span class="credit">Image: Rockstar Games</span>{% endif %}
</header>

{%- if tldr %}
<section class="sec sec-tight">
  <div class="wrap">
    <div class="tldr">
      <p class="kicker">In short</p>
      <ul>{% for t in tldr %}<li>{{ t | md | safe }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>
{%- endif %}

{%- if filters %}
<section class="sec sec-tight kfilter-sec">
  <div class="wrap">
    <div class="kfilter" role="group" aria-label="Filter by region">
      <span class="kfilter-l">Where</span>
      <button type="button" data-kfilter="all" aria-pressed="true">All</button>
      {%- for f in filters %}<button type="button" data-kfilter="{{ f.k }}" aria-pressed="false">{{ f.l }}</button>{% endfor %}
      <button type="button" data-kfilter="anywhere" aria-pressed="false">Not pinned down</button>
    </div>
    <p class="kfilter-n" aria-live="polite"></p>
  </div>
</section>
{%- endif %}

{%- for s in sections %}
<section class="sec ksec" id="{{ s.title | slugify }}">
  <div class="wrap">
    {%- if s.kicker %}<p class="kicker">{{ s.kicker }}</p>{% endif %}
    <h2 class="sec-h">{{ s.title }}</h2>
    {%- if s.lede %}<p class="lede">{{ s.lede | md | safe }}</p>{% endif %}
    {%- if s.cards %}
    <div class="kcards{% if s.compact %} compact{% endif %}">
      {%- for c in s.cards %}
      {%- set cid = c.id or (c.t | slugify) %}
      {%- set hasDlg = details and (c.more or c.region or c.links) %}
      <article class="kcard{% if c.img %} has-img{% endif %}" id="{{ cid }}"{% if filters %} data-region="{{ (c.region or ['anywhere']) | join(' ') }}"{% endif %}>
        {%- if c.img %}<img src="{{ c.img }}" {% if c.full %}data-full="{{ c.full }}" {% endif %}data-zoom="{{ s.title | slugify }}" alt="{{ c.alt or c.t }}" width="800" height="450" loading="lazy">{% endif %}
        <div class="kbody">
          {%- if c.tag %}<p class="pin">{{ c.tag }}</p>{% endif %}
          <h3>{{ c.t }}</h3>
          {%- if c.d %}<p>{{ c.d | md | safe }}</p>{% endif %}
          {%- if c.status %}<p class="kmeta">{% if c.status %}<span class="chip {% if c.status == 'Reported' %}rum{% else %}ok{% endif %} dot">{{ c.status }}</span>{% endif %}</p>{% endif %}
          {%- if hasDlg %}<a class="kmore" href="#{{ cid }}" data-dlg="dlg-{{ cid }}" aria-haspopup="dialog">Details<span aria-hidden="true"> →</span></a>{% endif %}
        </div>
        {%- if hasDlg %}
        <dialog class="kdlg" id="dlg-{{ cid }}" aria-labelledby="dlg-{{ cid }}-h">
          <div class="kdlg-in">
            <button type="button" class="kdlg-x" data-close aria-label="Close">✕</button>
            {%- if c.img %}<img src="{{ c.full or c.img }}" alt="{{ c.alt or c.t }}" width="1600" height="900" loading="lazy">{% endif %}
            <div class="kdlg-body">
              <p class="kicker">{{ s.title }}</p>
              <h3 id="dlg-{{ cid }}-h">{{ c.t }}</h3>
              <p class="kdlg-lede">{{ c.d | md | safe }}</p>
              {%- if c.more %}<ul class="klist one">{% for m in c.more %}<li>{{ m | md | safe }}</li>{% endfor %}</ul>{% endif %}
              <dl class="who-dl kdlg-dl">
                <div><dt>Where</dt><dd>{% if c.region %}{% for r in c.region %}{% set rg = regions | where("slug", r) | first %}<a href="/map/{{ r }}/">{{ rg.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% else %}Not pinned down yet{% endif %}</dd></div>
                {%- if c.status %}<div><dt>Status</dt><dd>{{ c.status }}</dd></div>{% endif %}
              </dl>
              {%- if detailNote %}<div class="tip"><span class="lab">Tip</span><div class="tip-body"><p>{{ detailNote }}</p></div></div>{% endif %}
              <div class="kdlg-soon"><p class="kicker">Added after launch</p><p>Map location, how to unlock it, rewards and tips, once we have checked them in the game.</p></div>
              {%- if c.links %}<p class="kdlg-links">{% for l in c.links %}<a href="{{ l.u }}">{{ l.l }} →</a>{% endfor %}</p>{% endif %}
            </div>
          </div>
        </dialog>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if s.list %}
    <ul class="klist">{% for i in s.list %}<li>{{ i | md | safe }}</li>{% endfor %}</ul>
    {%- endif %}
    {%- if s.chips %}
    <div class="castlist">{% for p in s.chips %}<span>{{ p }}</span>{% endfor %}</div>
    {%- endif %}
  </div>
</section>
{%- endfor %}

{%- if content | trim %}
<section class="sec"><div class="wrap prose">{{ content | callouts | safe }}</div></section>
{%- endif %}

<section class="sec">
  <div class="wrap">
    <div class="empty">
      <p class="kicker">In progress</p>
      <h2 class="sec-h sm">This page is still growing</h2>
      <p>Everything above comes from Rockstar or from press that spoke to Rockstar. As we play, each item gets checked in the game and expanded with locations and tips.</p>
    </div>
  </div>
</section>

<section class="sec sec-tight"><div class="wrap"><p class="fig-credit">Images: Rockstar Games</p></div></section>
