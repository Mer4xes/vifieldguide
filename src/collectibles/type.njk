---js
{
  layout: "layouts/base.njk",
  pagination: { data: "db.collectibles.types", size: 1, alias: "t", addAllPagesToCollections: true },
  permalink: (data) => `collectibles/${data.t.slug}/`,
  crumbParent: { label: "Collectibles", url: "/collectibles/" },
  eleventyComputed: {
    title: (data) => data.t.name,
    seoTitle: (data) => data.t.seoTitle ? data.t.seoTitle : data.t.total ? `GTA 6 ${data.t.name}: All ${data.t.total} and What 100% Needs` : `GTA 6 ${data.t.name}: How They Work and What 100% Needs`,
    description: (data) => data.t.description ||
      `${data.t.name} in GTA 6: ${data.t.total ? data.t.total + " in the game, " : ""}${data.t.need ? data.t.need + " for 100%" : ""}${data.t.trophy ? ", the " + data.t.trophy.replace(/ \(.*\)$/, "") + " trophy" : ""}. How to find them, with a counter that saves your progress.`,
    sample: (data) => !!data.t.sample,
    updated: (data) => data.t.updated,
  },
}
---
<header class="mast" style="--glow:var(--cyan)">
  <div class="wrap">
    <p class="kicker">Collectible set</p>
    <h1>{{ t.name }}</h1>
    <p class="tagline">{{ t.desc }}</p>
    <div class="chips"><span class="chip rum dot">Reported</span></div>
    <dl class="meta">
      {%- if t.total %}<div><dt>In the game</dt><dd>{{ t.total }}</dd></div>{% endif %}
      {%- if t.need %}<div><dt>100% needs</dt><dd>{{ t.need }}</dd></div>{% elif t.extra %}<div><dt>100% needs</dt><dd>None</dd></div>{% endif %}
      {%- if t.trophy %}<div class="wide"><dt>Trophy</dt><dd>{{ t.trophy }}</dd></div>{% endif %}
      {%- if t.items.length %}<div><dt>Mapped so far</dt><dd>{{ t.items.length }}</dd></div>{% endif %}
      {%- if t.reward %}<div class="wide"><dt>Reward</dt><dd>{{ t.reward }}</dd></div>{% endif %}
    </dl>
    {%- if t.ctr %}
    <div class="ctrs one">{% set ctr = t.ctr %}{% set label = t.counterLabel %}{% include "partials/ctr.njk" %}</div>
    {%- endif %}
    {%- if t.items.length %}
    <div class="progress" data-progress="col:{{ t.slug }}:" data-total="{{ t.items.length }}">
      <div class="row"><span class="lab">Ticked off below</span><span class="pct"><span data-done>0</span> / {{ t.items.length }} mapped{% if t.total %} of {{ t.total }}{% endif %}</span></div>
      <div class="bar"><i></i></div>
    </div>
    {%- endif %}
  </div>
</header>

{%- if t.how and t.how.length %}
<section class="sec">
  <div class="wrap">
    <p class="kicker">How it works</p>
    <h2 class="sec-h">Finding {{ t.name | lower }}</h2>
    <ul class="howlist">
      {%- for h in t.how %}<li>{{ h | md | safe }}</li>{% endfor %}
    </ul>
    {%- if t.note %}
    <div class="tip warn"><span class="lab">Watch out</span><div class="tip-body"><p>{{ t.note | md | safe }}</p></div></div>
    {%- endif %}
    {%- if t.sets and t.sets.length %}
    <h2 class="sec-h sm" style="margin-top:30px">The {{ t.sets.length }} sets</h2>
    <div class="castlist">{% for x in t.sets %}{% if t.setLinks[x] %}<a href="{{ t.setLinks[x] }}" title="Every card in this set is mapped">{{ x }}</a>{% else %}<span>{{ x }}</span>{% endif %}{% endfor %}</div>
    {%- if t.setPages and t.setPages.length %}
    <p class="lede" style="margin-top:12px">Fully mapped, with its own page: {% for sp in t.setPages %}<a href="{{ t.setLinks[sp.name] }}">{{ sp.name }}</a> ({{ sp.size }}{% if sp.reward %}, unlocks {{ sp.reward }}{% endif %}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {%- endif %}
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="sec">
  <div class="wrap">
    {%- if not t.items.length %}
    <div class="empty"><p>No locations listed yet. We add them once a trusted source, or two that agree, shows where they are, so you won't be sent to the wrong place.</p></div>
    {%- endif %}
    {%- set multi = t.itemSets.length > 1 %}
    {%- if multi %}
    <div class="filters" data-filter-group="col" role="group" aria-label="Filter by set">
      <button type="button" class="fchip is-on" data-filter="*" aria-pressed="true">All · {{ t.items.length }}</button>
      <button type="button" class="fchip" data-filter="todo" aria-pressed="false">Not found</button>
      {%- for s in t.itemSets %}
      <button type="button" class="fchip" data-filter="{{ s.slug }}" aria-pressed="false">{{ s.name }} · {{ s.count }}</button>
      {%- endfor %}
    </div>
    {%- endif %}
    <div{% if multi %} data-filter-list="col"{% endif %}>
    {%- for c in t.byCounty %}
    {%- set here = c.items %}
    {%- if here.length %}
    <div class="chapter"{% if multi %} data-filter-parent{% endif %}>
      <h2 class="chapter-h">{% if c.slug %}<a href="/collectibles/area/{{ c.slug }}/">{{ c.name }}</a>{% else %}{{ c.name }}{% endif %}<span>{{ here.length }}</span></h2>
      {%- if not c.slug %}<p class="lede">These are in the city, but which neighbourhood each one is in isn't known yet, so they aren't on a county checklist.</p>{% endif %}
      <ul class="items">
        {%- for i in here %}
        {%- set key = "col:" + t.slug + ":" + i.id %}
        {%- set sslug = "" %}{% for s in t.itemSets %}{% if s.name == i.set %}{% set sslug = s.slug %}{% endif %}{% endfor %}
        <li class="item" data-track-row id="{{ i.id }}"{% if multi %} data-tags="{{ sslug or 'set-none' }}"{% endif %}>
          <input class="cb" type="checkbox" id="c-{{ t.slug }}-{{ i.id }}" data-track="{{ key }}" aria-label="Mark {{ i.name }} found">
          <span class="item-no">{% if i.n %}{{ i.n | pad }}{% else %}·{% endif %}</span>
          <div class="item-body">
            <label for="c-{{ t.slug }}-{{ i.id }}" class="item-name">{{ i.name }}</label>
            <p class="item-meta">{% if i.set %}<span>{{ i.set }}{% if i.n %} #{{ i.n }}{% endif %}</span>{% endif %}<span>{{ i.area }}</span>{% if i.who %}<span>{{ i.who }}</span>{% endif %}{% if i.missable %}<span class="miss">Missable · {{ i.missable }}</span>{% endif %}</p>
            {%- if i.where %}<p>{{ i.where | md | safe }}</p>{% endif %}
              {%- include "partials/shots.njk" %}
            {%- if i.mission %}<a class="more" href="/walkthrough/{{ i.mission }}/">Reachable during a mission</a>{% endif %}
          </div>
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- endfor %}
    </div>
    {%- if multi %}<p class="nomatch" data-nomatch="col" hidden>Nothing left here for that filter.</p>{% endif %}
    {%- if t.items.length %}<button class="reset" type="button" data-reset="col:{{ t.slug }}:">Reset this set</button>{% endif %}
    <p class="lede" style="margin-top:22px">See all <a href="/collectibles/">collectible sets</a>, the <a href="/collectibles/#by-area">checklists by area</a>, the <a href="/map/#tracker">map tracker</a> or the <a href="/guides/100-percent-checklist/">100% checklist</a>.</p>
    {%- if t.updated %}<p class="stamp">Last updated {{ t.updated | niceDate }}</p>{% endif %}
  </div>
</section>

{%- if t.faq and t.faq.length %}
<section class="sec" id="faq">
  <div class="wrap">
    <p class="kicker">FAQ</p>
    <h2 class="sec-h">Quick answers</h2>
    <div class="faq">
      {%- for q in t.faq %}
      <details{% if loop.first %} open{% endif %}><summary>{{ q.q }}</summary><div>{{ q.a | md | safe }}</div></details>
      {%- endfor %}
    </div>
  </div>
</section>
<script type="application/ld+json">{{ t.faq | faqld | safe }}</script>
{%- endif %}
