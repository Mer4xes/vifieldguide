---js
{
  layout: "layouts/base.njk",
  pagination: { data: "db.collectibles.types", size: 1, alias: "t", addAllPagesToCollections: true },
  permalink: (data) => `collectibles/${data.t.slug}/`,
  crumbParent: { label: "Collectibles", url: "/collectibles/" },
  eleventyComputed: {
    title: (data) => data.t.name,
    seoTitle: (data) => data.t.total ? `GTA 6 ${data.t.name}: All ${data.t.total} and What 100% Needs` : `GTA 6 ${data.t.name}: How They Work and What 100% Needs`,
    description: (data) =>
      `${data.t.name} in GTA 6: ${data.t.total ? data.t.total + " in the game, " : ""}${data.t.need ? data.t.need + " for 100%" : ""}${data.t.trophy ? ", the " + data.t.trophy.replace(/ \(.*\)$/, "") + " trophy" : ""}. How to find them, with a counter that saves your progress.`,
    sample: (data) => !!data.t.sample,
    updated: (data) => data.t.updated,
  },
}
---
<header class="mast" style="--glow:var(--cyan)">
  <div class="wrap">
    <p class="kicker">Collectible set</p>
    <h1>{{ t.name }}</h1>
    <p class="tagline">{{ t.desc }}</p>
    <div class="chips"><span class="chip rum dot">Reported</span><span class="chip plain">First pass, not yet verified in-game</span></div>
    <dl class="meta">
      {%- if t.total %}<div><dt>In the game</dt><dd>{{ t.total }}</dd></div>{% endif %}
      {%- if t.need %}<div><dt>100% needs</dt><dd>{{ t.need }}</dd></div>{% endif %}
      {%- if t.trophy %}<div class="wide"><dt>Trophy</dt><dd>{{ t.trophy }}</dd></div>{% endif %}
      {%- if t.items.length %}<div><dt>Mapped here</dt><dd>{{ t.items.length }}</dd></div>{% endif %}
      {%- if t.reward %}<div class="wide"><dt>Reward</dt><dd>{{ t.reward }}</dd></div>{% endif %}
    </dl>
    {%- if t.items.length %}
    <div class="progress" data-progress="col:{{ t.slug }}:" data-total="{{ t.total }}">
      <div class="row"><span class="lab">Found</span><span class="pct"><span data-done>0</span> / {{ t.total }}</span></div>
      <div class="bar"><i></i></div>
    </div>
    {%- elif t.ctr %}
    <div class="ctrs one">{% set ctr = t.ctr %}{% set label = t.counterLabel %}{% include "partials/ctr.njk" %}</div>
    {%- endif %}
  </div>
</header>

{%- if t.how and t.how.length %}
<section class="sec">
  <div class="wrap">
    <p class="kicker">How it works</p>
    <h2 class="sec-h">Finding {{ t.name | lower }}</h2>
    <ul class="howlist">
      {%- for h in t.how %}<li>{{ h | md | safe }}</li>{% endfor %}
    </ul>
    {%- if t.note %}
    <div class="tip warn"><span class="lab">Watch out</span><div class="tip-body"><p>{{ t.note | md | safe }}</p></div></div>
    {%- endif %}
    {%- if t.sets and t.sets.length %}
    <h2 class="sec-h sm" style="margin-top:30px">The {{ t.sets.length }} sets</h2>
    <div class="castlist">{% for x in t.sets %}<span>{{ x }}</span>{% endfor %}</div>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="sec">
  <div class="wrap">
    {%- if not t.items.length %}
    <div class="empty"><p>No locations listed yet. We add them once a trusted source, or two that agree, shows where they are, so you won't be sent to the wrong place.</p></div>
    {%- endif %}
    {%- for r in regions %}
    {%- set here = t.items | where("region", r.slug) %}
    {%- if here.length %}
    <div class="chapter">
      <h2 class="chapter-h"><a href="/map/{{ r.slug }}/">{{ r.short or r.name }}</a><span>{{ here.length }}</span></h2>
      <ul class="items">
        {%- for i in here %}
        <li class="item" data-track-row id="n-{{ i.n }}">
          <input class="cb" type="checkbox" id="c-{{ t.slug }}-{{ i.n }}" data-track="col:{{ t.slug }}:{{ i.n }}" aria-label="Mark number {{ i.n }} found">
          <span class="item-no">{{ i.n | pad }}</span>
          <div class="item-body">
            <label for="c-{{ t.slug }}-{{ i.n }}" class="item-name">{{ i.name }}</label>
            <p>{{ i.where | md | safe }}</p>
            {%- if i.image %}<img src="{{ i.image }}" alt="Location of {{ t.name }} number {{ i.n }}: {{ i.name }}" loading="lazy" decoding="async">{% endif %}
            {%- if i.mission %}<a class="more" href="/walkthrough/{{ i.mission }}/">Reachable during a mission</a>{% endif %}
          </div>
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- endfor %}
    {%- if t.items.length %}<button class="reset" type="button" data-reset="col:{{ t.slug }}:">Reset this set</button>{% endif %}
    <p class="lede" style="margin-top:22px">See all <a href="/collectibles/">collectible sets</a>, the <a href="/map/#tracker">map tracker</a> or the <a href="/guides/100-percent-checklist/">100% checklist</a>.</p>
    {%- if t.updated %}<p class="stamp">Last updated {{ t.updated | niceDate }}</p>{% endif %}
  </div>
</section>
